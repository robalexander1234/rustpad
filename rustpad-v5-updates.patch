+    /// Updates the 3-item LRU list of recently edited files (most recent at index 0).
+    fn record_recent_file(&mut self, path: &Path) {
+        if self.recent_files.first().map(|p| p.as_path()) == Some(path) {
+            return;
+        }
+        self.recent_files.retain(|p| p.as_path() != path);
+        self.recent_files.insert(0, path.to_path_buf());
+        self.recent_files.truncate(3);
+    }
